rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny-all fallback
    match /{document=**} {
      allow read, write: if false;
    }

    // Bookings collection
    match /bookings/{bookingId} {
      // Authenticated users can read only their own bookings
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;

      // Authenticated users can create bookings matching their own UID with validated fields
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.numberOfPeople is number
        && request.resource.data.numberOfPeople >= 1
        && request.resource.data.totalPrice is number
        && request.resource.data.totalPrice > 0
        && request.resource.data.travelerName is string
        && request.resource.data.travelDate is string
        && request.resource.data.tripId is number;

      // Allow users to delete (cancel) only their own bookings
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;

      // Disallow updating existing bookings directly from client
      allow update: if false;
    }

    // User wishlists collection
    match /wishlists/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
